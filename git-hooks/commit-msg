#!/usr/bin/env python3
"""Yaya Loop commit-msg completion gate for non-Claude agents.

On every commit, compare the staged Feature index with HEAD. When a Feature
newly changes from pending, in_progress, or missing to done, require a matching
Feature-specific `Code smell scan: pass` line with must_fix equal to zero.

This is a commit-msg Hook rather than pre-commit because it needs both the
staged index and the complete commit message.

Install:
    cp git-hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
"""

import json
import re
import subprocess
import sys
from pathlib import Path

FEATURE_LIST_PATH = "docs/feature-list.json"
EVIDENCE_PATTERN = re.compile(
    r"^Code smell scan:\s*pass\s*\(\s*"
    r"feature:\s*(F\d+)\s*,\s*"
    r"must_fix:\s*0\s*,\s*"
    r"suggest:\s*\d+\s*,\s*"
    r"acceptable:\s*\d+\s*\)\s*$",
    re.IGNORECASE | re.MULTILINE,
)


def get_staged_feature_list_before_after():
    """Return the HEAD and staged Feature indexes, or `(None, None)` to skip."""
    # Staged version.
    try:
        staged_blob = subprocess.run(
            ["git", "show", f":{FEATURE_LIST_PATH}"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    except subprocess.CalledProcessError:
        return None, None
    try:
        staged_data = json.loads(staged_blob)
    except json.JSONDecodeError:
        return None, None

    # HEAD version may not exist when the index is first committed.
    try:
        head_blob = subprocess.run(
            ["git", "show", f"HEAD:{FEATURE_LIST_PATH}"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
        head_data = json.loads(head_blob)
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        head_data = {"features": []}

    return head_data, staged_data


def find_newly_done(head_data, staged_data):
    """Return Feature IDs newly changed to done in the staged index."""
    head_status = {f["id"]: f.get("status") for f in head_data.get("features", [])}
    newly_done = []
    for f in staged_data.get("features", []):
        if f.get("status") == "done":
            prev = head_status.get(f["id"])
            if prev != "done":  # pending, in_progress, or missing -> done
                newly_done.append(f["id"])
    return newly_done


def main():
    if len(sys.argv) < 2:
        # Git normally always supplies the commit-message path as argv[1].
        return 0

    msg_path = Path(sys.argv[1])
    if not msg_path.exists():
        return 0
    commit_msg = msg_path.read_text(encoding="utf-8")

    head_data, staged_data = get_staged_feature_list_before_after()
    if staged_data is None:
        # The Feature index is absent from the commit or cannot be parsed: fail open.
        return 0

    newly_done = find_newly_done(head_data, staged_data)
    if not newly_done:
        return 0

    evidenced = set(EVIDENCE_PATTERN.findall(commit_msg))
    missing_evidence = [feature_id for feature_id in newly_done if feature_id not in evidenced]
    if not missing_evidence:
        return 0

    sys.stderr.write(
        "\n"
        "-------------------------------------------------------------\n"
        "Yaya Loop commit-msg Hook: commit blocked\n"
        "-------------------------------------------------------------\n"
        f"Features newly marked done: {', '.join(newly_done)}\n"
        f"Features missing valid scan evidence: {', '.join(missing_evidence)}\n"
        "\n"
        "Complete execute-next-feature Stage 6, then add the final evidence line\n"
        "to this commit message and retry:\n"
        "Code smell scan: pass (feature: F0XX, must_fix: 0, suggest: N, acceptable: M)\n"
        "\n"
        "Git escape hatch (strongly discouraged):\n"
        "    git commit --no-verify\n"
        "-------------------------------------------------------------\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
